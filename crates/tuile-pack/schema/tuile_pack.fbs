// SPDX-License-Identifier: MIT OR Apache-2.0
// Copyright (c) lapoule.dev
//
// The pre-baked scene container: what was decided at the bake — which tiles
// each frame draws — with either the bytes a render needs (`Embedded`), or
// where to read them in the tile store (`References`), or both.
//
// Regenerate the Rust with:
//
//     flatc --rust --gen-all -o crates/tuile-pack/src schema/tuile_pack.fbs
//
// and commit the result. `flatc` is deliberately NOT a build dependency: the
// image's Rust stage is a bare `rust:1-bookworm`, and a generator nobody has
// is a build that nobody can reproduce. `the_generated_code_matches_the_schema`
// is what keeps the two in step.

namespace tuile.pack;

/// One payload in the blob region that follows the table.
///
/// Compression and zero-copy do not contradict each other once they are
/// separated: the structure is read in place, and each payload is an
/// independent block, decoded only if something asks for it.
struct Block {
  /// From the start of the blob region, not from the start of the file.
  offset: uint64;
  /// Bytes on disk.
  stored: uint32;
  /// Bytes once decoded. Known in advance, so a reader allocates once. Equal
  /// to `stored` for a payload stored as produced — see `Tile.texture_format`,
  /// which is what says whether the texture block was compressed at all.
  raw: uint32;
}

enum TextureFormat : byte {
  None = 0,
  Png = 1,
}

/// What a pack carries for its tiles.
///
/// A pack was first everything a render needs. It can now be the plan alone:
/// which tiles each frame draws and where each comes from, the bytes staying
/// in the tile store they were read from at the bake. This says which, so
/// that no reader has to infer it from what happens to be present.
enum Content : byte {
  /// The finished meshes and composed textures, in the blob region.
  Embedded = 0,
  /// References to the tile store's tiles; no payload.
  References = 1,
  /// Both: one pack that renders either way, which is how the two ways are
  /// compared.
  Both = 2,
}

/// The terrain tile a mesh was built from, in the store's terrain layer.
///
/// Not necessarily the tile that was asked for: where the source has no tile
/// at a level, the mesh is cut from the nearest ancestor that exists, and
/// this names that ancestor. `Tile.id` remains the tile drawn.
struct TerrainRef {
  x: uint32;
  y: uint32;
  level: uint8;
  /// FNV-1a of the tile's bytes as the store held them at the bake. A store
  /// is alive — a tile is fetched again when it expires — and this is how a
  /// render knows it is no longer looking at what was baked.
  digest: uint64;
}

/// One imagery tile of a drape and where it lies on the terrain tile: what
/// the composition of the texture needs, in the order it is stacked.
struct ImageryRef {
  x: uint32;
  y: uint32;
  level: uint8;
  /// The part of the terrain tile's uv this imagery tile covers:
  /// west, south, east, north.
  cover_w: float;
  cover_s: float;
  cover_e: float;
  cover_n: float;
  /// uv of the imagery tile = uv of the terrain tile × scale + translation.
  translate_u: float;
  translate_v: float;
  scale_u: float;
  scale_v: float;
  /// As `TerrainRef.digest`.
  digest: uint64;
}

/// One tile, deduplicated across the whole frame range.
///
/// The identity is `(id, drape)`, never `id` alone: a tile keeps its id from
/// one frame to the next but is re-draped as the camera moves, and two
/// drapings of one tile are two different pictures. A tile visible over forty
/// frames at one draping is stored once.
table Tile {
  id: uint64;
  drape: uint64;
  /// ECEF, f64 — positions below are f32 RELATIVE to this. Narrowing that
  /// subtraction is the one thing not to do.
  origin_ecef: [double];
  vertex_count: uint32;
  index_count: uint32;
  base_color_factor: [float];
  positions: Block;
  normals: Block;
  uvs: Block;
  indices: Block;
  texture: Block;
  texture_format: TextureFormat;
  // ── since version 3; absent from a pack that only embeds ──────────────
  /// Where the mesh comes from.
  terrain: TerrainRef;
  /// How deep the mesh's skirts hang, in metres: a choice of the bake, not
  /// something the tile's bytes say.
  skirt_height: float;
  /// The drape, bottom layer first. Empty for a tile with no imagery.
  imagery: [ImageryRef];
  /// The side of the composed texture, in texels.
  composed_side: uint32;
}

/// The camera one frame was baked for. Twelve doubles, exactly the shape the
/// ABI's `TuileViewState` carries.
///
/// It is here because a render has no frame number to ask with: the host cooks
/// at a timecode and hands the session a camera. So a pack is addressed by the
/// camera it was baked for, and a camera that matches nothing in the pack is
/// the stage and the pack disagreeing — which must be an error, not a guess.
struct View {
  px: double; py: double; pz: double;
  dx: double; dy: double; dz: double;
  ux: double; uy: double; uz: double;
  vw: double; vh: double;
  fovy: double;
}

/// What one frame selected, as indices into `Pack.tiles`.
table Frame {
  frame: uint32;
  tiles: [uint32];
  view: View;
}

table Pack {
  /// Bumped when the layout changes in a way an old reader would misread.
  version: uint32;
  /// The digest of the scene this is the bake of. A reader that computes a
  /// different one is holding the wrong pack, and must say so rather than
  /// render it.
  scene_digest: string;
  first_frame: uint32;
  last_frame: uint32;
  render_origin: [double];
  /// FNV-1a over the whole blob region, taken at write time.
  ///
  /// A pack travels: written on one machine, pushed to R2, pulled onto a pod,
  /// read by sixteen processes. A payload that arrives bent does not
  /// necessarily fail to decompress — it can hand back plausible bytes, and a
  /// renderer then draws slightly wrong ground and reports success. Checked at
  /// open, once, because that is the only moment at which the answer is still
  /// cheap and still actionable.
  blob_digest: uint64;
  /// How the selection was culled when this was baked — "full" or "disabled".
  ///
  /// A pack freezes its selection: a hole baked in is a hole for ever, and it
  /// is invisible in the output. This is the admission, carried with the data,
  /// so a pack made under a known-imperfect cull can never pass for a good one.
  culling: string;
  /// The deduplicated pool, sorted by (id, drape).
  tiles: [Tile];
  /// One entry per frame in `[first_frame, last_frame]`, in order.
  frames: [Frame];
  // ── since version 3 ────────────────────────────────────────────────────
  /// What the tiles carry. A pack of an earlier version says nothing here
  /// and reads as `Embedded`, which is what it is.
  content: Content;
  /// The layers of the tile store the references are into.
  terrain_layer: string;
  imagery_layer: string;
}

root_type Pack;
file_identifier "TUIL";
