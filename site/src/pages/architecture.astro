import Base from '../layouts/Base.astro';

const traits = `/// Abstract I/O: the core does not know where the bytes come from.
pub trait TileFetcher: Send + Sync {
    async fn fetch(&self, url: &Url) -> Result<Bytes, FetchError>;
}

/// A byte cache a loader consults before fetching. A cache, not a
/// database: any get may miss, every value can be recomputed.
pub trait ContentStore: Send + Sync {
    async fn get(&self, key: &str) -> Option<Bytes>;
    async fn put(&self, key: &str, value: Bytes, ttl: Option<Duration>);
}

/// The tile hierarchy the traversal walks — 3D Tiles, terrain, or both.
pub trait TileTree: Send + Sync { /* roots, children, properties … */ }

/// Loads and decodes a tile, and composes the imagery that drapes it.
pub trait TileLoader: Send + Sync {
    async fn load(&self, id: TileId) -> Result<Loaded, LoadError>;
    async fn load_drape(&self, id: TileId, layer: LayerId, level: u32)
        -> Result<DrapeContent, LoadError>;
}`;

const stream = `/// The project's master seam: the streaming protocol,
/// independent of any transport.
pub trait GeometryStream: Send {
    fn send(&self, msg: ClientMessage) -> Result<(), StreamError>;
    fn poll_message(&mut self, cx: &mut Context<'_>) -> Poll<Option<ServerMessage>>;
}

// ClientMessage : ViewerState | Ack { bytes } | Discarded | Retarget
//                 | Pressure | Thermal | ReleaseBeyond | Ahead
// ServerMessage : Select { draw, plan, … } | Content | Cancel | Evict
//                 | Error | Priming`;

const flow = `ViewerState (one view per eye or viewport)
   │
   ▼
Traversal (tuile-core) ── screen-space error, frustum and horizon culling,
   │                      REPLACE / ADD, hold until the children are ready
   ▼
Budget::decide ── pure and deterministic: what to load, deliver, draw and
   │              evict, per memory class, under hard limits
   ├──► TileLoader ──► TileFetcher (+ ContentStore) ──► decode off the frame
   ├──► Content ──► the consumer uploads in plan order ──► Ack { bytes }
   ├──► Select  ──► the consumer draws: new before old, never a gap
   └──► Evict   ──► released after the draw that stops using it`;

const rules = `tuile-budget    → thiserror                       (pure, deterministic, zero I/O)
tuile-ground    → thiserror, glam (f64), libm     (pure, deterministic, zero I/O)
tuile-b3dm      → serde_json, thiserror           (pure codec, zero I/O)
tuile-core      → tuile-budget, tuile-b3dm, serde, glam (f64), gltf, image, texcomp,
                  async traits — and NO runtime (tokio only behind the
                  optional native feature "rt-tokio")
tuile-terrain, tuile-planetary, tuile-camera, tuile-atmosphere
                → tuile-core                      (render-agnostic, wasm-clean)
tuile-wgpu      → tuile-core, wgpu, texcomp
tuile-viewer    → tuile-wgpu, tuile-planetary, winit; native fetchers or
                  the browser transport, per target
tuile-hydra     → tuile-core, tuile-bake — a C ABI and nothing else

forbidden in tuile-core: any renderer, any HTTP framework, an unconditional
async runtime, std::fs on production paths (tests excepted)`;

type Item = [string, string] | [string, string, 'review'];

const crates: { group: string; items: Item[] }[] = [
  {
    group: 'The standard and the globe',
    items: [
      ['tuile-core', 'Tileset parsing, screen-space-error traversal, content decoding, the graphics budget, the geometry server and the streaming protocol. Render-agnostic, wasm-clean.'],
      ['tuile-budget', 'The graphics budget: what is loaded, uploaded, drawn and evicted, decided by one pure, deterministic step. Re-exported by tuile-core, wasm-clean.'],
      ['tuile-ground', 'The authoritative ground: one deterministic terrain contract — pluggable frames, versioned tiles, ordered edits, water, batched queries — that a simulation steps on and a renderer draws. wasm-clean.'],
      ['tuile-b3dm', 'The legacy 3D Tiles 1.0 batched-model container: parse and encode, zero I/O.'],
      ['tuile-terrain', 'Quantized-mesh decoding and encoding, geographic tiling, a heightfield source, terrain from any layer.json URL.'],
      ['tuile-planetary', 'Terrain × imagery assembled into one tile tree and one loader, backend-agnostic.'],
      ['tuile-camera', 'Globe camera and input controller producing the core view states. Knows no renderer.'],
      ['tuile-atmosphere', 'Sun position, aerial perspective and sky for a rendered globe — renderer-agnostic.'],
      ['tuile-ui', 'On-screen navigation controls (compass, tilt, zoom) with no renderer dependency.'],
      ['tuile-overlay', 'Geometry an application hands a renderer to draw in the world, and how it meets the ground.'],
    ],
  },
  {
    group: 'Rendering and applications',
    items: [
      ['tuile-wgpu', 'The reference render backend: native, WebGPU and WebGL2; the budget’s executor; draws into a frame a host owns.'],
      ['tuile-viewer', 'The interactive viewer as a library — window, camera, controls, steering — over any terrain and imagery source; desktop, iOS, Android and web shells.'],
      ['tuile-viewer-bundle', 'Packages the viewer as a macOS application and writes the phone builds’ resources.'],
      ['tuile-bevy', 'The globe inside a Rust game engine, drawn by tuile-wgpu on the engine’s own device and targets.', 'review'],
    ],
