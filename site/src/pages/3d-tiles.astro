const sse = `sse = (geometricError * viewportHeight)
      / (distanceToCamera * 2 * tan(fovY / 2))`;

const states = `Unloaded → Loading → Decoded → Resident → (Evicted)`;

const pitfalls = [
  ['The Y-up to Z-up rotation on glTF content', 'Forget it and every model lies on its side. Classic mistake number one.'],
  ['A geometric error of zero on a leaf', 'Means never attempt to refine further. Not "refine infinitely".'],
  ['Refinement inherited from the parent', 'When a tile omits refine, it takes the parent’s, not the default.'],
  ['Regions are in radians', 'Not degrees. The bounding-region variant is the only one that is angular.'],
  ['transform is column-major', 'Same convention as glTF. Compose root to leaf.'],
  ['The legacy container carries a centre offset', 'Read it from the feature table and compose it into the transform, or the tile lands kilometres away.'],
  ['f64 everywhere before rebasing', 'The single rule that decides whether the render jitters.'],
  ['External tilesets graft at the referencing tile’s error', 'Not at their own root error.'],
];
