import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../../layouts/Base.astro';

// Where `scripts/rustdoc.mjs` staged the generated HTML. In development that is
// `public/`; after `astro build` the same tree has been copied into
// `dist/client/`, which the standalone Node server serves. Try the places the
// process could reasonably be started from, and degrade gracefully if none of
// them match — a wrong guess must never hide the links.
const candidates = [
  join(process.cwd(), 'dist', 'client', 'docs', 'api'),
  join(process.cwd(), 'public', 'docs', 'api'),
  join(process.cwd(), '..', 'client', 'docs', 'api'),
];
const stage = candidates.find((p) => existsSync(join(p, 'crates.js')));

// The provider connectors are documented in rustdoc's own crate switcher; this
// page describes the engine, and the engine is defined by the standard.
const hidden = new Set(['tuile_cesium_ion', 'tuile_bing']);

const groups: Record<string, string> = {
  tuile_core: 'The standard',
  tuile_b3dm: 'The standard',
  tuile_terrain: 'The standard',
  tuile_planetary: 'The standard',
  tuile_camera: 'The standard',
  tuile_wgpu: 'Rendering',
  tuile_atmosphere: 'Rendering',
  tuile_ui: 'Rendering',
  tuile_native_fetchers: 'Transport and runtime',
  tuile_web: 'Transport and runtime',
  tuile_storage_foyer: 'Transport and runtime',
  tuile_metrics: 'Transport and runtime',
  tuile_pack: 'Offline: bake, replay, USD',
  tuile_bake: 'Offline: bake, replay, USD',
  tuile_tape: 'Offline: bake, replay, USD',
  tuile_usd: 'Offline: bake, replay, USD',
  tuile_hydra: 'Offline: bake, replay, USD',
};

const order = [
  'The standard',
  'Rendering',
  'Transport and runtime',
  'Offline: bake, replay, USD',
  'Examples and harnesses',
];

const found = stage
  ? readdirSync(stage, { withFileTypes: true })
      .filter((e) => e.isDirectory() && existsSync(join(stage, e.name, 'index.html')))
      .map((e) => e.name)
      .filter((n) => !hidden.has(n))
      .sort()
  : Object.keys(groups).sort();

const sections = order
  .map((title) => ({
    title,
    crates: found.filter((c) => (groups[c] ?? 'Examples and harnesses') === title),
  }))
  .filter((s) => s.crates.length > 0);
---

<Base
  title="API reference — Tuile"
  description="The generated Rust API documentation for every crate in the Tuile workspace, built with cargo doc and served by this site under /docs/api/."
  kicker="API reference"
  heading="The crates, as rustdoc sees them."
  lede="This is the generated Rust documentation for the workspace — every public type, trait and module, with the source linked. It is built by cargo, not written by hand, and it is the authority when this site and the code disagree."
>
  {!stage && (
    <p class="note">
      <strong>Not generated on this instance.</strong> The links below will return 404 until
      the rustdoc has been built and staged. From the <code>site/</code> directory run
      <code>npm run docs:api</code>, then rebuild: <code>npm run build</code>. Nothing
      generated is committed, so a fresh checkout always starts in this state.
    </p>
  )}

  {sections.map((s) => (
    <>
      <h3>{s.title}</h3>
      <ul class="crate-list">
        {s.crates.map((c) => (
          <li>
            <span class="name"><a href={`/docs/api/${c}/index.html`}>{c}</a></span>
            <span class="what">
              <a href={`/docs/api/${c}/all.html`}>all items</a>
            </span>
          </li>
        ))}
      </ul>
    </>
  ))}

  <p>
    Crate names are the rustdoc form, with underscores. Rustdoc's own crate switcher, in the
    sidebar of any page above, lists everything in the workspace — the two data-provider
    connector crates included. Its search box covers all of them at once.
  </p>

  <h2>Where to start reading</h2>

  <ul>
    <li>
      <code>tuile_core::protocol</code> — the message types and the
      <code>GeometryStream</code> trait. If you read one module, read this one: the shape of
      the whole project is in it.
    </li>
    <li>
      <code>tuile_core::traversal</code> — screen-space error, culling, refinement, and the
      selection it produces.
    </li>
    <li>
      <code>tuile_core::content</code> — the two content forms and the decoders that turn
      one into the other.
    </li>
    <li>
      <code>tuile_core::fetch</code> and <code>tuile_core::cache</code> — the input seams,
      and the implementations of them that live in the transport crates.
    </li>
    <li>
      <code>tuile_core::geo</code> and <code>tuile_core::math</code> — the f64 geodetic and
      bounding-volume arithmetic everything upstream depends on.
    </li>
  </ul>

  <h2>How this is wired</h2>

  <p>
    <code>cargo doc --workspace --no-deps</code> writes rustdoc into the workspace's
    <code>target/doc</code>. The site's <code>npm run docs:api</code> runs exactly that and
    then copies the result into <code>site/public/docs/api/</code>, which Astro copies into
    <code>dist/client/</code>, which the standalone Node server serves. There is no route
    handler in between — rustdoc's relative links, its shared assets and its search index
    all work unmodified, because nothing rewrites them.
  </p>

  <p>
    The one file deliberately not copied is a root index, so that <code>/docs/api/</code>
    stays this page. Everything below it is rustdoc's.
  </p>

  <p class="note">
    The generated tree is around 22 MB and is <strong>gitignored</strong>. Regenerating it
    costs a couple of minutes of cold compilation and seconds thereafter. It is not part of
    <code>npm run build</code>, so editing a page does not pay for a documentation build;
    <code>npm run build:all</code> runs both in order.
  </p>
</Base>
