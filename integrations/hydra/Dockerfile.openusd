# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright (c) lapoule.dev
#
# THE OpenUSD base image. There is only one, and it is CUDA-capable.
#
# Built on the in-cluster amd64 builder, cached and published through Harbor:
#
# Locally, on an arm64 developer machine — no driver stack, Embree only:
#
#   docker build -f integrations/hydra/Dockerfile.openusd \
#       --build-arg BASE_IMAGE=ubuntu:24.04 \
#       -t tuile-openusd:26.08-local-arm64 .
#
# For the farm, natively on amd64, cached and published through Harbor:
#
#   docker buildx build --builder stl-builder-k8s --platform linux/amd64 \
#       -f integrations/hydra/Dockerfile.openusd \
#       --cache-to   type=registry,ref=harbor.sportstracklive.com/tuile/openusd-cache,mode=max \
#       --cache-from type=registry,ref=harbor.sportstracklive.com/tuile/openusd-cache \
#       -t harbor.sportstracklive.com/tuile/openusd:26.08 --push .
#
# WHY NOT A SEPARATE CPU IMAGE: this one already renders without a GPU. It
# carries Storm *and* Embree, and Embree is a CPU ray tracer that needs no
# device, no driver and no display — `usdrecord --renderer Embree --disableGpu`
# works on a machine with no card at all, on a CUDA base image, because the
# base only *offers* CUDA rather than requiring it. A second CPU-only recipe
# would double the build time and, worse, drift: two recipes meant to produce
# the same OpenUSD always diverge eventually, and that surfaces as "the plugin
# only loads on half the nodes". The renderer is a runtime flag, not a build.
#
# The remaining cost is size — the CUDA devel base ships a toolkit nothing uses
# at run time. If that is ever measured to matter, the answer is a multi-stage
# build that compiles here and copies /opt/usd into nvidia/cuda:...-runtime.
# Not done now: one recipe, one artefact, until size is a real problem.
#
# The amd64 variant has NOT been executed yet — it needs an amd64 host with
# enough memory, and the job-count note below is the thing most likely to bite
# there. The arm64 variant is built and proven: the plugin loads and renders
# under usdrecord in it.

ARG USD_VERSION=v26.08

# The only thing that differs between the image the farm pulls and the one a
# developer renders against locally. It was two Dockerfiles until it became
# clear they had converged on the same feature set and the same assertions,
# leaving one line of actual difference — which is an argument, not a file.
#
#   default                 x86_64 with a CUDA/GL driver stack. Storm and Embree.
#   ubuntu:24.04            no driver stack; Embree only in practice. What an
#                           arm64 developer machine can build and run.
#
# Pinned for the same reason as OpenUSD itself: a moving base changes the
# toolchain under a plugin that is only loadable by the exact build it was made
# against.
ARG BASE_IMAGE=nvidia/cuda:12.6.2-devel-ubuntu24.04

FROM ${BASE_IMAGE}
ARG USD_VERSION
ENV DEBIAN_FRONTEND=noninteractive

# libglvnd + EGL: Storm renders headless through EGL, with no X server and no
# display. The mesa dev packages supply headers; at run time the NVIDIA
# container runtime injects the real driver over them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git curl ca-certificates \
        python3 python3-dev python3-pip python3-setuptools \
        libx11-dev libxt-dev libgl1-mesa-dev libglu1-mesa-dev \
        libglvnd-dev libegl1 libegl1-mesa-dev \
        zlib1g-dev libbz2-dev liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o openusd.tar.gz \
        "https://github.com/PixarAnimationStudios/OpenUSD/archive/refs/tags/${USD_VERSION}.tar.gz" \
    && tar xzf openusd.tar.gz \
    && mv "OpenUSD-${USD_VERSION#v}" OpenUSD \
    && rm openusd.tar.gz

# THE JOB COUNT IS BOUNDED BY MEMORY, AND MEMORY MUST BE READ FROM THE CGROUP.
#
# Inside a Kubernetes pod, both `nproc` and /proc/meminfo report the *node's*
# resources, not the container's limits. On a 12-core / 31 GB node with a
# limits.memory of 4Gi, the naive `-j $(nproc)` launches twelve compilers sized
# for 31 GB and the pod is OOM-killed — after an hour, with an exit code that
# says nothing useful. The cgroup files below are the only honest source.
#
# 1.5 GB per compiler is measured, not guessed: an earlier arm64 build ran
# `-j 8` on 8 cores with 10 GB, drove available memory under 1 GB, pushed
# 3.6 GB into swap, and its throughput collapsed from ~30 compiled objects per
# minute to ~4 once it reached hdSt and usdImaging, whose translation units are
# template-heavy. Fewer jobs finish sooner.
#
# The same feature set in every build. Embree stays alongside Storm: a node
# whose driver failed can still produce a frame, and that should be a flag
# rather than a redeploy.
RUN set -eu; \
    mem="$(cat /sys/fs/cgroup/memory.max 2>/dev/null \
        || cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null \
        || echo max)"; \
    case "$mem" in \
        ''|max|*[!0-9]*) mem="$(awk '/MemTotal/ {print $2 * 1024}' /proc/meminfo)" ;; \
    esac; \
    jobs=$((mem / 1500000000)); \
    if [ "$jobs" -lt 1 ]; then jobs=1; fi; \
    cpus="$(nproc)"; \
    if [ "$jobs" -gt "$cpus" ]; then jobs="$cpus"; fi; \
    echo "building with -j ${jobs} (memory budget $((mem / 1024 / 1024)) MiB, ${cpus} cpus)"; \
    python3 -u OpenUSD/build_scripts/build_usd.py \
        --python --usd-imaging --embree \
        --materialx --openimageio --opencolorio --openvdb \
        --alembic --ptex --draco \
        --no-usdview \
        --no-examples --no-tutorials --no-tests --no-docs --no-python-docs \
        --no-prman --no-vulkan \
        -j "${jobs}" \
        /opt/usd; \
    rm -rf /src/OpenUSD /src/*.tar.gz

ENV PATH=/opt/usd/bin:$PATH \
    LD_LIBRARY_PATH=/opt/usd/lib

# Make `import pxr` work, and prove it here rather than discovering it later.
#
# OpenUSD installs its Python modules under a *version-stamped* directory —
# /opt/usd/lib/python3.12/site-packages on this base — so the PYTHONPATH of
# /opt/usd/lib/python that older documentation suggests points at nothing. The
# failure surfaces as `usdrecord: ModuleNotFoundError: No module named 'pxr'`,
# which reads like a broken build rather than a wrong path.
#
# A .pth file registered with the system interpreter is version-proof: it is
# discovered wherever python3 lives, survives a base image whose Python moves
# from 3.12 to 3.13, and needs no environment variable that a caller might drop.
# The import at the end turns this from a hope into a build-time assertion.
RUN set -eu; \
    sp="$(python3 -c 'import site; print(site.getsitepackages()[0])')"; \
    usd="$(ls -d /opt/usd/lib/python*/site-packages | head -1)"; \
    echo "$usd" > "$sp/openusd.pth"; \
    python3 -c 'import pxr; print("pxr importable from", pxr.__file__)'; \
    usdrecord --help > /dev/null; \
    for lib in hdGp usdProcImaging usdImaging; do \
        test -e "/opt/usd/lib/libusd_${lib}.so" || { echo "missing lib: $lib" >&2; exit 1; }; \
    done; \
    test -e /opt/usd/plugin/usd/hdEmbree.so || { echo "missing hdEmbree" >&2; exit 1; }; \
    echo "base image verified: hdGp, usdProcImaging, usdImaging, hdEmbree"

ENV HDGP_INCLUDE_DEFAULT_RESOLVER=1

# Ask the container runtime for a driver that can do graphics, not only compute.
# The default is compute-only and Storm then fails to create a context, with an
# error that says nothing about this.
#
# Harmless on a base image with no NVIDIA runtime underneath — nothing reads
# them — which is what lets one recipe serve both bases.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# Storm with no display. Not a fallback: usdrecord on a headless node has no
# other way to get a context.
ENV PXR_ENABLE_GL_CONTEXT_EGL=1

CMD ["/bin/bash"]
