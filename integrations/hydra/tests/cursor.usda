#usda 1.0
(
    defaultPrim = "Paraglider"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Doublure d'un asset glTF converti (voir docs/16, voie (b)) :
une delta-aile minimale, matériaux nommés pour être surchargés par over
depuis le stage — l'asset lui-même n'est jamais édité."""
)

def Xform "Paraglider"
{
    def Mesh "Wing"
    (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
        point3f[] points = [(-4, 0, 0), (0, 1.2, 0.6), (4, 0, 0), (0, -2.5, 0.2)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = 1
        rel material:binding = </Paraglider/Materials/Wing>
    }

    def Scope "Materials"
    {
        def Material "Wing"
        {
            token outputs:surface.connect = </Paraglider/Materials/Wing/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }
}
