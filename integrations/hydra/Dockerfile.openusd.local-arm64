# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright (c) lapoule.dev
#
# OpenUSD, and nothing else. Built once, tagged, and thereafter treated as a
# fixed dependency — see Dockerfile, which starts FROM the result.
#
# Its own file because it takes the better part of an hour while the plugin
# takes seconds. Folded into one build, every plugin edit risks re-entering an
# hour-long layer and one interrupted session throws the hour away.
#
#   docker build -f integrations/hydra/Dockerfile.openusd \
#       -t tuile-openusd:26.08-cpu .
#
# WHY THE INSTRUCTIONS BELOW LOOK CONSERVATIVE: their exact text is the cache
# key. They are byte-identical to the stage this file was extracted from, so an
# already-built layer is reused instead of recompiled. Editing the apt list, the
# `-j` expression, or the order of these three RUNs discards roughly an hour.
# Anything genuinely new goes *after* the build, where it is a cheap leaf layer.
#
# KNOWN ANNOYANCE, deliberately not fixed here: build_usd.py buffers its own
# stdout when it is not attached to a terminal, so the log stays empty for the
# whole hour and a slow build is indistinguishable from a hung one. The fix is
# `python3 -u`, which changes the RUN text and therefore discards the cached
# layer. Add it the next time this image is rebuilt from scratch anyway.

ARG USD_VERSION=v26.08

FROM ubuntu:24.04
ARG USD_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git curl ca-certificates \
        python3 python3-dev python3-pip python3-setuptools \
        libx11-dev libxt-dev libgl1-mesa-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# The release tarball rather than a clone: even shallow, the git protocol drops
# often enough that a half-finished clone fails the layer with no way to resume.
# curl retries, and the archive carries no history we would throw away anyway.
RUN curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o openusd.tar.gz \
        "https://github.com/PixarAnimationStudios/OpenUSD/archive/refs/tags/${USD_VERSION}.tar.gz" \
    && tar xzf openusd.tar.gz \
    && mv "OpenUSD-${USD_VERSION#v}" OpenUSD \
    && rm openusd.tar.gz

# Everything not needed to render a procedural is off: each extra component is
# build minutes now and image size on every farm pull later.
#
# `--python` stays because usdrecord *is* a Python script — dropping it leaves
# no way to render a frame.
RUN python3 OpenUSD/build_scripts/build_usd.py \
        --python --usd-imaging --embree \
        --no-usdview \
        --no-examples --no-tutorials --no-tests --no-docs --no-python-docs \
        --no-openimageio --no-opencolorio --no-openvdb --no-alembic \
        --no-draco --no-materialx --no-ptex --no-prman --no-vulkan \
        -j "$(nproc)" \
        /opt/usd \
    && rm -rf /src/OpenUSD /src/*.tar.gz

ENV PATH=/opt/usd/bin:$PATH \
    PYTHONPATH=/opt/usd/lib/python \
    LD_LIBRARY_PATH=/opt/usd/lib

# Without this OpenUSD never inserts the procedural-resolving scene index and
# any stage using one renders empty — no warning, no error, a valid and blank
# image. It is a TF_DEFINE_ENV_SETTING defaulting to false in
# hdGp/sceneIndexPlugin.cpp, so a plugin can neither detect nor fix its own
# absence. It belongs here, with OpenUSD, rather than with whatever uses it.
ENV HDGP_INCLUDE_DEFAULT_RESOLVER=1

# ----------------------------------------------------------------------------
# The pipeline surface.
#
# Appended rather than folded into the build above, and that is the whole point:
# everything above is already compiled, and its cache survives only while its
# text is untouched. This layer reuses boost, TBB, OpenSubdiv and Embree — the
# expensive dependencies — and builds only what is new.
#
# The pipeline is not only 3D Tiles. Shading, atmosphere, animation, imported
# imagery, volumes and materials are all in scope, so the components below are
# not speculative:
#
#   materialx     portable shading networks
#   openimageio   EXR/TIFF/DPX, and a tiled mipmapped texture cache
#   opencolorio   colour space transforms (ACES, sRGB, Rec.709)
#   openvdb       sparse volumes — clouds, haze, smoke
#   alembic       baked geometry and point caches from other tools
#   ptex          per-face textures, for assets authored without a UV layout
#   draco         compressed mesh interchange
#
# Six of those are OPT-IN in build_usd.py: --ptex, --openvdb, --openimageio,
# --opencolorio, --alembic and --draco all default to off, so omitting them is
# a silent default rather than a decision. Only --materialx and --usdview
# default to on, which is why the first is named here and the second refused.
#
# No --hdf5: the option is gone in v26.08, which builds Alembic with
# USE_HDF5=OFF. Ogawa-backed .abc files load; the historical HDF5-backed ones
# do not.
#
# usdview stays out. Qt plus PySide is the single most expensive item available
# here and it is useless on a headless farm node; inspecting a stage by hand
# belongs in a separate development image, not in every farm pull.

# System libraries the new dependencies expect to find rather than build.
# Deliberately NOT libboost-all-dev or libtbb-dev: build_usd.py builds those
# itself, and a system copy alongside is how CMake ends up taking headers from
# one and libraries from the other.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglu1-mesa-dev libglvnd-dev libegl1 libegl1-mesa-dev \
        libbz2-dev liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

# The sources were removed by the build above, so they come back. Everything
# already installed under /opt/usd is detected and skipped; OpenUSD itself is
# reconfigured with the new features and rebuilt.
#
# `python3 -u` here and not above: build_usd.py buffers its own stdout off a
# terminal, so without it the log is silent for the whole build and a slow build
# is indistinguishable from a hung one. It is safe to add on this layer, which
# has no cached predecessor to protect.
#
# The job count is capped by MEMORY, not by cores, and that is measured rather
# than assumed: the build above ran `-j $(nproc)` on 8 cores with 10 GB, drove
# MemAvailable under 1 GB, pushed 3.6 GB into swap, and its throughput fell from
# ~30 compiled objects per minute to ~4 once it reached hdSt and usdImaging —
# whose translation units are template-heavy and memory-hungry. Roughly 1.5 GB
# per parallel compiler keeps it out of swap; fewer jobs finish sooner.
RUN curl -fL --retry 5 --retry-delay 5 --retry-all-errors \
        -o openusd.tar.gz \
        "https://github.com/PixarAnimationStudios/OpenUSD/archive/refs/tags/${USD_VERSION}.tar.gz" \
    && tar xzf openusd.tar.gz \
    && mv "OpenUSD-${USD_VERSION#v}" OpenUSD \
    && rm openusd.tar.gz \
    && python3 -u OpenUSD/build_scripts/build_usd.py \
        --python --usd-imaging --embree \
        --materialx --openimageio --opencolorio --openvdb \
        --alembic --ptex --draco \
        --no-usdview \
        --no-examples --no-tutorials --no-tests --no-docs --no-python-docs \
        --no-prman --no-vulkan \
        -j "$(awk '/MemTotal/ {m=int($2/1024/1024/1.5)} END {n='"$(nproc)"'; print (m<n && m>0) ? m : n}' /proc/meminfo)" \
        /opt/usd \
    && rm -rf /src/OpenUSD /src/*.tar.gz

CMD ["/bin/bash"]
