@@ -67,7 +67,11 @@ SessionParams GetSessionParams(const HdRenderSettingsMap &settings)
 {
   SessionParams params;
   params.threads = 0;
-  params.background = false;
+  /* Batch mode on demand: sample straight to the target and denoise once,
+   * instead of progressive refinement with repeated denoising. The mode a
+   * frame recorder wants; interactive viewers keep the default. */
+  params.background = !PXR_NS::TfGetenv("CYCLES_BACKGROUND").empty() &&
+                      PXR_NS::TfGetenv("CYCLES_BACKGROUND") != "0";
   params.use_resolution_divider = false;
 
