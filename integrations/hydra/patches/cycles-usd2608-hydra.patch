@@ -138,6 +142,24 @@ HdCyclesDelegate::HdCyclesDelegate(const HdRenderSettingsMap &settingsMap,
 
     SetRenderSetting(setting.first, setting.second);
   }
+
+  /* Environment overrides, consistent with CYCLES_DEVICE: hosts whose
+   * recording path cannot deliver render settings to the delegate (usdrecord
+   * outside the render-settings scene index) still need control over the
+   * sample budget. */
+  const std::string samplesEnv = PXR_NS::TfGetenv("CYCLES_SAMPLES");
+  if (!samplesEnv.empty()) {
+    SetRenderSetting(HdCyclesRenderSettingsTokens->samples, VtValue(atoi(samplesEnv.c_str())));
+  }
+  const std::string denoiseEnv = PXR_NS::TfGetenv("CYCLES_DENOISE");
+  if (!denoiseEnv.empty()) {
+    SetRenderSetting(TfToken("cycles:integrator:use_denoise"), VtValue(denoiseEnv != "0"));
+  }
+  const std::string timeLimitEnv = PXR_NS::TfGetenv("CYCLES_TIME_LIMIT");
+  if (!timeLimitEnv.empty()) {
+    SetRenderSetting(HdCyclesRenderSettingsTokens->timeLimit,
+                     VtValue(atof(timeLimitEnv.c_str())));
+  }
 }
 
